# PostgreSQL connection used by the web process and worker. Render injects this in production.
DATABASE_URL=

# Public canonical URL used for secure redirects and absolute export links.
APP_URL=http://localhost:3000

# Secret used to sign the single-user production session. Generate a long random value.
SESSION_SECRET=

# Stable identifier for the initial authorized seller account.
APP_USER_EMAIL=

# Declared user agent for permitted public retrieval requests.
PUBLIC_RESEARCH_USER_AGENT=ProspectIntelligenceCockpit/0.1

# Optional provider-neutral search connector. The local Compose profile uses SearXNG.
PUBLIC_SEARCH_PROVIDER=searxng
PUBLIC_SEARCH_BASE_URL=http://127.0.0.1:8080

# Internal URL for the separately containerized public-page extraction worker.
PUBLIC_EXTRACTION_WORKER_URL=http://127.0.0.1:8787
# Comma-separated public hostnames approved for extraction; subdomains are not implicit.
PUBLIC_EXTRACTION_ALLOWED_HOSTS=example.org,www.example.org

# Enables deterministic local records and replay artifacts when optional providers are absent.
FIXTURE_MODE=true
