{
  "name": "prospect-intelligence-cockpit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @prospect-cockpit/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm format:check",
    "typecheck": "tsc --project tsconfig.base.json --noEmit",
    "test": "node --test",
    "test:unit": "node --test",
    "test:integration": "node --test",
    "test:e2e": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
